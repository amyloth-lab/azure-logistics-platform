prefix                      = "logistics"
environment                 = "dev"
location                    = "australiaeast"
sql_admin_login             = "logistics-sql-admin"
entra_role_assignment_object_id = null # set to the signing-in user's Entra object ID if different from the Terraform caller
enable_ansible_vm           = false # set true only after Total Regional Cores quota is available
enable_app_gateway          = false # set true only after public IP quota is available
app_gateway_hostname        = "api.logistics.example.com"
app_gateway_cert_path       = "cert.pfx"
app_gateway_cert_password   = "changeit"
waf_mode                    = "Detection"
enable_app_service          = false # set true only after App Service VM quota is available
app_service_sku             = "B1"
apim_publisher_name         = "Logistics Platform"
apim_publisher_email        = "platform@example.com"
firewall_sku_tier           = "Basic" # or "Standard" if Basic is unavailable
firewall_threat_intelligence_mode = "Alert"
budget_amount_usd           = 200
budget_contact_emails       = ["you@example.com"]
