prefix                      = "logistics"
environment                 = "dev"
location                    = "australiaeast"
sql_admin_login             = "logistics-sql-admin"
enable_app_service          = false # set true only after App Service VM quota is available
app_service_sku             = "B1"
apim_publisher_name         = "Logistics Platform"
apim_publisher_email        = "platform@example.com"
firewall_sku_tier           = "Basic" # or "Standard" if Basic is unavailable
firewall_threat_intelligence_mode = "Alert"
budget_amount_usd           = 200
budget_contact_emails       = ["you@example.com"]
